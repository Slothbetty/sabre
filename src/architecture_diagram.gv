digraph SABRE_Architecture {
  graph [
    rankdir=LR,
    nodesep=0.7,
    ranksep=1.1,
    fontname="Helvetica",
    label="StreamLens  —  System Architecture",
    labelloc=t,
    fontsize=16,
    splines=true
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=11,
    margin="0.18,0.10",
    fillcolor="#FFFFFF"
  ];

  edge [
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.7
  ];

  // ── Inputs ─────────────────────────────────────────────────────────────────
  subgraph cluster_inputs {
    label="Inputs";
    style="rounded,filled";
    color="#4477AA";
    fontcolor="#4477AA";
    fontsize=13;
    fillcolor="#EEF3FF";

    seek     [label="User Seek\n(seeks.json)",          fillcolor="#D8E5F8"];
    prefetch [label="Prefetch Config\n(prefetch.json)", fillcolor="#D8E5F8"];
    movie    [label="Movie / Manifest\n(movie.json)",   fillcolor="#D8E5F8"];
    network  [label="Network Trace\n(network.json)",    fillcolor="#D8E5F8"];
  }

  // ── Sabre Simulator ────────────────────────────────────────────────────────
  subgraph cluster_sabre {
    label="Sabre Simulator  (sabre.py)";
    style="rounded,filled";
    color="#333399";
    fontcolor="#333399";
    fontsize=13;
    fillcolor="#EEEEFF";
    margin="40,20";

    dl   [label="Download Loop",                              fillcolor="#C8C8F0", fontsize=12, margin="0.22,0.12"];
    abr  [label="ABR Policy\nBOLA · BOLAE · Dynamic · DynamicDash · Throughput",   fillcolor="#FADDEA"];
    buf  [label="MultiRegion Buffer",                         fillcolor="#C8EDDA"];
    pf   [label="Seek & Prefetch Handler",                    fillcolor="#FFF0A0"];

    { rank=same; abr; buf; pf; }

    dl -> abr [label="next quality?"];
    dl -> buf [label="add / play chunk"];
    dl -> pf  [label="seek / prefetch?"];
  }

  // ── Outputs ────────────────────────────────────────────────────────────────
  subgraph cluster_outputs {
    label="Outputs";
    style="rounded,filled";
    color="#44AA77";
    fontcolor="#44AA77";
    fontsize=13;
    fillcolor="#F0FFF4";

    qoe     [label="QoE",              fillcolor="#C8EDDA"];
    rebuf   [label="Rebuffering Time", fillcolor="#C8EDDA"];
    bitrate [label="Bitrates",         fillcolor="#C8EDDA"];
    buflvl  [label="Buffer Level",     fillcolor="#C8EDDA"];
  }

  // ── Inputs → Simulator ─────────────────────────────────────────────────────
  seek     -> pf  [color="#4477AA"];
  prefetch -> pf  [color="#4477AA"];
  movie    -> dl  [color="#4477AA"];
  network  -> dl  [color="#4477AA"];

  // ── Simulator → Outputs ────────────────────────────────────────────────────
  abr -> qoe     [color="#44AA77"];
  abr -> bitrate [color="#44AA77"];
  buf -> buflvl  [color="#44AA77"];
  dl  -> rebuf   [color="#44AA77"];
}
